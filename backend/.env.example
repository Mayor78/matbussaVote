PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK - paste the JSON from Firebase Console > Project Settings > Service Accounts
# Either set GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
# OR paste the full JSON inline:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# For inline JSON (recommended for deployment):
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"election-system-d15fa","private_key":"YOUR_PRIVATE_KEY_HERE","client_email":"YOUR_CLIENT_EMAIL_HERE"}

# Cache TTLs in seconds
CACHE_TTL_ELECTIONS=300
CACHE_TTL_BUNDLE=120
CACHE_TTL_STATS=60
CACHE_TTL_POSITIONS=300
CACHE_TTL_CANDIDATES=300
